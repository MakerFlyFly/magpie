{
  "has_bare_issue_numbers": {
    "field": "has_bare_issue_numbers",
    "type": "field_true"
  },
  "has_security_model_quote": {
    "field": "has_security_model_quote",
    "type": "field_true"
  },
  "has_kept_tracker_first": {
    "field": "comment_body",
    "type": "regex",
    "pattern": "`/?security-issue-deduplicate\\s+#?212\\s+#?250`"
  },
  "mention_handles": {
    "field": "mention_handles",
    "type": "regex",
    "pattern": "^\\[\"@[^\"]+\"(, \"@[^\"]+\"){0,2}\\]$"
  }
}
